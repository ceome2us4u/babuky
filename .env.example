# Copy to apps/api/.env.local (backend) and apps/web/.env.local (frontend)
# and fill in real values. Never commit real secrets.

# ============================================================
# apps/api — backend service (api.babuki.com)
# ============================================================

PORT=8000

# Database (self-hosted PostgreSQL + PostGIS on Babuki's own EC2 box —
# not shared with, or related to, any Me2Us4U infra)
DATABASE_URL=postgres://babuki:password@localhost:5432/babuki

# Session cookies (HMAC pepper for the session-token hash — generate with
# `openssl rand -hex 32`)
SESSION_SECRET=

# MSG91 (same company account as Me2Us4U's other products — Babuki uses its
# own OTP template id inside that account, not a new signup)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay (same company account as Me2Us4U's other products — pull these
# from the Razorpay dashboard; RAZORPAY_VENDOR_PLAN_ID is Babuki's own
# ₹500/mo early-bird plan, separate from any plans other products use)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_VENDOR_PLAN_ID=plan_TdVzzDQoYIGSj0

# S3 (Babuki's own private bucket for vendor item photos — presigned
# browser uploads; instance IAM role handles auth in production)
AWS_REGION=ap-south-1
BABUKI_S3_BUCKET=

# ============================================================
# apps/web — frontend (babuki.com + *.babuki.com)
# ============================================================

# Where the frontend calls the backend — the separate apps/api service,
# never this app's own /api/* (there is no server logic in apps/web).
NEXT_PUBLIC_API_URL=https://api.babuki.com

# Same Razorpay key id as above, exposed to the browser for Checkout.js
# (the public key id, never the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

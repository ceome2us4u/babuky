# Copy to apps/api/.env.local (backend) and apps/web/.env.local (frontend)
# and fill in real values. Never commit real secrets.

# ============================================================
# apps/api — backend service (api.babuki.com)
# ============================================================

PORT=8000

# Database (self-hosted PostgreSQL + PostGIS on Babuki's own EC2 box —
# not shared with, or related to, any Me2Us4U infra)
DATABASE_URL=postgres://babuki:password@localhost:5432/babuki

# Session cookies (HMAC pepper for the session-token hash — generate with
# `openssl rand -hex 32`)
SESSION_SECRET=

# MSG91 (same company account as Me2Us4U's other products, not a new signup).
# Babuki currently uses the SAME DLT-approved OTP template as Home (see
# scripts/deploy.sh); the SMS is sent through MSG91's Flow API and the code is
# generated and checked by Babuki itself (apps/api/src/lib/msg91.ts).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Name of the template's merge variable, if it isn't "number".
MSG91_OTP_VAR=

# TEST / LIVE — ONE switch for everything (same as Home's APP_MODE).
#   test        -> no SMS is sent (the fixed code 12345 signs in ANY number,
#                  returned to the UI as devOtpHint) and Razorpay uses the
#                  *_TEST credentials below.
#   live / unset -> real MSG91 SMS and the *_LIVE Razorpay credentials.
# On the box it is flipped with `scripts/set-app-mode.sh test|live <host>` —
# never by editing code; scripts/deploy.sh preserves it. /health reports it.
APP_MODE=live

# Razorpay (same company account as Me2Us4U's other products). Both sets sit
# side by side; the API picks by APP_MODE and FAILS CLOSED if the active set is
# missing (test mode never falls back to live keys). RAZORPAY_VENDOR_PLAN_ID_*
# is Babuki's own ₹500/mo early-bird plan — the TEST one must be created in
# Razorpay's Test mode. On the box the TEST values come from Secrets Manager
# (babuki/prod/razorpay-{key-id,key-secret,webhook-secret,vendor-plan-id}-test).
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_LIVE=
RAZORPAY_VENDOR_PLAN_ID_LIVE=plan_TdVzzDQoYIGSj0
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_VENDOR_PLAN_ID_TEST=

# S3 (Babuki's own private bucket for vendor item photos — presigned
# browser uploads; instance IAM role handles auth in production)
AWS_REGION=ap-south-1
BABUKI_S3_BUCKET=

# ============================================================
# apps/web — frontend (babuki.com + *.babuki.com)
# ============================================================

# Where the frontend calls the backend — the separate apps/api service,
# never this app's own /api/* (there is no server logic in apps/web).
NEXT_PUBLIC_API_URL=https://api.babuki.com

# (No Razorpay key here on purpose: the API returns the active mode's
# publishable key id with each payment, so flipping APP_MODE needs no rebuild.)
